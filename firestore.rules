rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true && request.auth.token.email is string;
    }

    function isBootstrappedAdmin() {
      return isVerifiedUser() && request.auth.token.email == 'waleedpharmacy6@gmail.com';
    }

    function isAdmin() {
      return isBootstrappedAdmin() || (
        isVerifiedUser() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true
      );
    }

    function isSupervisorOrAdmin() {
      return isAdmin() || (
        isVerifiedUser() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'supervisor'] &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true
      );
    }

    function isAuthorizedReader() {
      return isSupervisorOrAdmin() || (
        isVerifiedUser() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true
      );
    }

    function isListAuthorized() {
      return isVerifiedUser() && (
        isBootstrappedAdmin() ||
        resource.data.ownerUid == request.auth.uid ||
        (resource.data.allowedEmails is list && resource.data.allowedEmails.hasAny([request.auth.token.email]))
      );
    }

    function isValidDateStr(d) {
      return d is string && d.size() == 10 && d.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function isValidTimeStr(t) {
      return t is string && t.size() == 5 && t.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$');
    }

    function isValidOptTimeStr(t) {
      return t is string && (t == '' || (t.size() == 5 && t.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')));
    }

    function isValidAllowedEmails(arr) {
      return arr is list && arr.size() >= 1 && arr.size() <= 10 && arr[0] is string && arr[0].size() <= 120;
    }

    function isValidDayList(arr) {
      return arr is list && arr.size() <= 7 && (arr.size() == 0 || (arr[0] is int && arr[0] >= 0 && arr[0] <= 6));
    }

    function isValidEmployee(data) {
      return data.keys().hasAll([
          'employeeCode', 'name', 'department', 'defaultScheduleId',
          'defaultCheckIn', 'defaultCheckOut', 'workDays', 'restDays',
          'startDate', 'status', 'ownerUid', 'allowedEmails', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'employeeCode', 'name', 'department', 'defaultScheduleId',
          'defaultCheckIn', 'defaultCheckOut', 'workDays', 'restDays',
          'hourlyRate', 'startDate', 'status', 'ownerUid', 'allowedEmails', 'createdAt', 'updatedAt'
        ]) &&
        data.employeeCode is string && data.employeeCode.size() >= 4 && data.employeeCode.size() <= 20 && data.employeeCode.matches('^EMP-[0-9]{3,6}$') &&
        data.name is string && data.name.size() >= 2 && data.name.size() <= 100 &&
        data.department is string && data.department.size() >= 2 && data.department.size() <= 60 &&
        isValidId(data.defaultScheduleId) && data.defaultScheduleId.size() <= 64 &&
        isValidTimeStr(data.defaultCheckIn) &&
        isValidTimeStr(data.defaultCheckOut) &&
        isValidDayList(data.workDays) &&
        isValidDayList(data.restDays) &&
        (!data.keys().hasAny(['hourlyRate']) || (data.hourlyRate is number && data.hourlyRate >= 0 && data.hourlyRate <= 100000)) &&
        isValidDateStr(data.startDate) &&
        data.status in ['active', 'inactive'] &&
        data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128 &&
        isValidAllowedEmails(data.allowedEmails) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidWorkSchedule(data) {
      return data.keys().hasAll([
          'name', 'checkInTime', 'checkOutTime', 'crossesMidnight',
          'durationMinutes', 'description', 'isActive', 'ownerUid', 'allowedEmails', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'name', 'checkInTime', 'checkOutTime', 'crossesMidnight',
          'durationMinutes', 'description', 'isActive', 'ownerUid', 'allowedEmails', 'createdAt', 'updatedAt'
        ]) &&
        data.name is string && data.name.size() >= 2 && data.name.size() <= 80 &&
        isValidTimeStr(data.checkInTime) &&
        isValidTimeStr(data.checkOutTime) &&
        data.crossesMidnight is bool &&
        data.durationMinutes is int && data.durationMinutes > 0 && data.durationMinutes <= 1440 &&
        data.description is string && data.description.size() <= 200 &&
        data.isActive is bool &&
        data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128 &&
        isValidAllowedEmails(data.allowedEmails) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidAttendanceRecord(data) {
      return data.keys().hasAll([
          'date', 'employeeId', 'employeeCode', 'employeeName', 'department',
          'scheduleId', 'scheduleName', 'scheduledCheckIn', 'scheduledCheckOut',
          'crossesMidnight', 'actualCheckIn', 'actualCheckOut', 'status',
          'lateMinutes', 'earlyArrivalMinutes', 'earlyLeaveMinutes', 'overtimeMinutes',
          'actualWorkedMinutes', 'netTimeDiffMinutes', 'notes',
          'updatedByName', 'updatedByEmail', 'ownerUid', 'allowedEmails', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'date', 'employeeId', 'employeeCode', 'employeeName', 'department',
          'scheduleId', 'scheduleName', 'scheduledCheckIn', 'scheduledCheckOut',
          'crossesMidnight', 'actualCheckIn', 'actualCheckOut', 'status',
          'lateMinutes', 'earlyArrivalMinutes', 'earlyLeaveMinutes', 'overtimeMinutes',
          'actualWorkedMinutes', 'netTimeDiffMinutes', 'notes',
          'updatedByName', 'updatedByEmail', 'ownerUid', 'allowedEmails', 'createdAt', 'updatedAt'
        ]) &&
        isValidDateStr(data.date) &&
        isValidId(data.employeeId) && data.employeeId.size() <= 64 &&
        data.employeeCode is string && data.employeeCode.size() <= 20 &&
        data.employeeName is string && data.employeeName.size() >= 2 && data.employeeName.size() <= 100 &&
        data.department is string && data.department.size() <= 60 &&
        isValidId(data.scheduleId) && data.scheduleId.size() <= 64 &&
        data.scheduleName is string && data.scheduleName.size() >= 2 && data.scheduleName.size() <= 80 &&
        isValidTimeStr(data.scheduledCheckIn) &&
        isValidTimeStr(data.scheduledCheckOut) &&
        data.crossesMidnight is bool &&
        isValidOptTimeStr(data.actualCheckIn) &&
        isValidOptTimeStr(data.actualCheckOut) &&
        data.status in ['present', 'absent', 'leave', 'rest'] &&
        data.lateMinutes is int && data.lateMinutes >= 0 && data.lateMinutes <= 1440 &&
        data.earlyArrivalMinutes is int && data.earlyArrivalMinutes >= 0 && data.earlyArrivalMinutes <= 1440 &&
        data.earlyLeaveMinutes is int && data.earlyLeaveMinutes >= 0 && data.earlyLeaveMinutes <= 1440 &&
        data.overtimeMinutes is int && data.overtimeMinutes >= 0 && data.overtimeMinutes <= 1440 &&
        data.actualWorkedMinutes is int && data.actualWorkedMinutes >= 0 && data.actualWorkedMinutes <= 1440 &&
        data.netTimeDiffMinutes is int && data.netTimeDiffMinutes >= -1440 && data.netTimeDiffMinutes <= 1440 &&
        data.notes is string && data.notes.size() <= 300 &&
        data.updatedByName is string && data.updatedByName.size() <= 100 &&
        data.updatedByEmail is string && data.updatedByEmail.size() <= 120 &&
        data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128 &&
        isValidAllowedEmails(data.allowedEmails) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidHoliday(data) {
      return data.keys().hasAll([
          'date', 'name', 'type', 'appliesToAll', 'employeeId', 'notes',
          'ownerUid', 'allowedEmails', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'date', 'name', 'type', 'appliesToAll', 'employeeId', 'notes',
          'ownerUid', 'allowedEmails', 'createdAt', 'updatedAt'
        ]) &&
        isValidDateStr(data.date) &&
        data.name is string && data.name.size() >= 2 && data.name.size() <= 100 &&
        data.type in ['official_holiday', 'weekly_rest', 'special_leave'] &&
        data.appliesToAll is bool &&
        data.employeeId is string && data.employeeId.size() <= 64 &&
        data.notes is string && data.notes.size() <= 300 &&
        data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128 &&
        isValidAllowedEmails(data.allowedEmails) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidUserAccount(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'role', 'active', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'email', 'displayName', 'role', 'active', 'createdAt', 'updatedAt']) &&
        isValidId(data.uid) && data.uid.size() <= 128 &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 120 &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100 &&
        data.role in ['admin', 'supervisor', 'viewer'] &&
        data.active is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidAuditLog(data) {
      return data.keys().hasAll([
          'action', 'entityType', 'entityId', 'summary',
          'performedByUid', 'performedByName', 'performedByEmail',
          'ownerUid', 'allowedEmails', 'createdAt'
        ]) &&
        data.keys().hasOnly([
          'action', 'entityType', 'entityId', 'summary',
          'performedByUid', 'performedByName', 'performedByEmail',
          'ownerUid', 'allowedEmails', 'createdAt'
        ]) &&
        data.action in ['create', 'update', 'delete', 'status_change', 'restore'] &&
        data.entityType in ['employee', 'schedule', 'attendance', 'holiday', 'user', 'settings', 'backup'] &&
        data.entityId is string && data.entityId.size() >= 1 && data.entityId.size() <= 128 &&
        data.summary is string && data.summary.size() >= 1 && data.summary.size() <= 300 &&
        data.performedByUid is string && data.performedByUid.size() >= 1 && data.performedByUid.size() <= 128 &&
        data.performedByName is string && data.performedByName.size() <= 100 &&
        data.performedByEmail is string && data.performedByEmail.size() <= 120 &&
        data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128 &&
        isValidAllowedEmails(data.allowedEmails) &&
        data.createdAt is timestamp;
    }

    function isValidSystemSettings(data) {
      return data.keys().hasAll([
          'pharmacyName', 'branchName', 'departments', 'authorizedEmails',
          'nextEmployeeSeq', 'ownerUid', 'allowedEmails', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'pharmacyName', 'branchName', 'departments', 'authorizedEmails',
          'nextEmployeeSeq', 'ownerUid', 'allowedEmails', 'createdAt', 'updatedAt'
        ]) &&
        data.pharmacyName is string && data.pharmacyName.size() >= 2 && data.pharmacyName.size() <= 100 &&
        data.branchName is string && data.branchName.size() <= 100 &&
        data.departments is list && data.departments.size() >= 1 && data.departments.size() <= 20 && data.departments[0] is string && data.departments[0].size() <= 60 &&
        data.authorizedEmails is list && data.authorizedEmails.size() >= 1 && data.authorizedEmails.size() <= 10 && data.authorizedEmails[0] is string && data.authorizedEmails[0].size() <= 120 &&
        data.nextEmployeeSeq is int && data.nextEmployeeSeq >= 1 && data.nextEmployeeSeq <= 999999 &&
        data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128 &&
        isValidAllowedEmails(data.allowedEmails) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    match /employees/{employeeId} {
      allow get: if isValidId(employeeId) && isAuthorizedReader();
      allow list: if isListAuthorized();
      allow create: if isValidId(employeeId) && isSupervisorOrAdmin() && isValidEmployee(incoming()) &&
        incoming().ownerUid == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/work_schedules/$(incoming().defaultScheduleId));
      allow update: if isValidId(employeeId) && isSupervisorOrAdmin() && isValidEmployee(incoming()) &&
        incoming().ownerUid == existing().ownerUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/work_schedules/$(incoming().defaultScheduleId)) &&
        (isAdmin() || incoming().diff(existing()).affectedKeys().hasOnly([
          'name', 'department', 'defaultScheduleId', 'defaultCheckIn', 'defaultCheckOut',
          'workDays', 'restDays', 'hourlyRate', 'startDate', 'status', 'allowedEmails', 'updatedAt'
        ]));
      allow delete: if isValidId(employeeId) && isAdmin();
    }

    match /work_schedules/{scheduleId} {
      allow get: if isValidId(scheduleId) && isAuthorizedReader();
      allow list: if isListAuthorized();
      allow create: if isValidId(scheduleId) && isSupervisorOrAdmin() && isValidWorkSchedule(incoming()) &&
        incoming().ownerUid == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(scheduleId) && isSupervisorOrAdmin() && isValidWorkSchedule(incoming()) &&
        incoming().ownerUid == existing().ownerUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (isAdmin() || incoming().diff(existing()).affectedKeys().hasOnly([
          'name', 'checkInTime', 'checkOutTime', 'crossesMidnight', 'durationMinutes',
          'description', 'isActive', 'allowedEmails', 'updatedAt'
        ]));
      allow delete: if isValidId(scheduleId) && isAdmin();
    }

    match /attendance_records/{recordId} {
      allow get: if isValidId(recordId) && isAuthorizedReader();
      allow list: if isListAuthorized();
      allow create: if isValidId(recordId) && isSupervisorOrAdmin() && isValidAttendanceRecord(incoming()) &&
        recordId == (incoming().date + '_' + incoming().employeeId + '_' + incoming().scheduleId) &&
        incoming().ownerUid == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/employees/$(incoming().employeeId)) &&
        exists(/databases/$(database)/documents/work_schedules/$(incoming().scheduleId));
      allow update: if isValidId(recordId) && isSupervisorOrAdmin() && isValidAttendanceRecord(incoming()) &&
        incoming().ownerUid == existing().ownerUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().date == existing().date &&
        incoming().employeeId == existing().employeeId &&
        incoming().scheduleId == existing().scheduleId &&
        incoming().updatedAt == request.time &&
        (isAdmin() || incoming().diff(existing()).affectedKeys().hasOnly([
          'actualCheckIn', 'actualCheckOut', 'status', 'lateMinutes', 'earlyArrivalMinutes',
          'earlyLeaveMinutes', 'overtimeMinutes', 'actualWorkedMinutes', 'netTimeDiffMinutes',
          'notes', 'updatedByName', 'updatedByEmail', 'allowedEmails', 'updatedAt'
        ]));
      allow delete: if isValidId(recordId) && isAdmin();
    }

    match /holidays/{holidayId} {
      allow get: if isValidId(holidayId) && isAuthorizedReader();
      allow list: if isListAuthorized();
      allow create: if isValidId(holidayId) && isSupervisorOrAdmin() && isValidHoliday(incoming()) &&
        incoming().ownerUid == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(holidayId) && isSupervisorOrAdmin() && isValidHoliday(incoming()) &&
        incoming().ownerUid == existing().ownerUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (isAdmin() || incoming().diff(existing()).affectedKeys().hasOnly([
          'date', 'name', 'type', 'appliesToAll', 'employeeId', 'notes', 'allowedEmails', 'updatedAt'
        ]));
      allow delete: if isValidId(holidayId) && isAdmin();
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && isVerifiedUser() && (request.auth.uid == userId || isAdmin());
      allow list: if isVerifiedUser() && (isBootstrappedAdmin() || resource.data.uid == request.auth.uid);
      allow create: if isValidId(userId) && isVerifiedUser() && isValidUserAccount(incoming()) &&
        incoming().uid == userId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        (
          (userId == request.auth.uid && (
            (isBootstrappedAdmin() && incoming().role == 'admin' && incoming().active == true) ||
            (incoming().role == 'viewer' && incoming().active == true)
          )) ||
          isAdmin()
        );
      allow update: if isValidId(userId) && isVerifiedUser() && isValidUserAccount(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().email == existing().email &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'role', 'active', 'updatedAt'])) ||
          (request.auth.uid == userId && incoming().role == existing().role && incoming().active == existing().active &&
            incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'updatedAt']))
        );
      allow delete: if isValidId(userId) && isAdmin();
    }

    match /audit_logs/{logId} {
      allow get: if isValidId(logId) && isAdmin();
      allow list: if isListAuthorized();
      allow create: if isValidId(logId) && isSupervisorOrAdmin() && isValidAuditLog(incoming()) &&
        incoming().performedByUid == request.auth.uid &&
        incoming().ownerUid == request.auth.uid &&
        incoming().createdAt == request.time;
      allow update, delete: if false;
    }

    match /system_settings/{settingId} {
      allow get: if isValidId(settingId) && isAuthorizedReader();
      allow list: if isListAuthorized();
      allow create: if isValidId(settingId) && isAdmin() && isValidSystemSettings(incoming()) &&
        incoming().ownerUid == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(settingId) && isSupervisorOrAdmin() && isValidSystemSettings(incoming()) &&
        incoming().ownerUid == existing().ownerUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly([
            'pharmacyName', 'branchName', 'departments', 'authorizedEmails',
            'nextEmployeeSeq', 'allowedEmails', 'updatedAt'
          ])) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['nextEmployeeSeq', 'updatedAt'])
        );
      allow delete: if false;
    }
  }
}
